# Copy to .env on the server (never commit real values)
PORT=8787
# TigerData service connection string (Console → service → Connect). Omit to run in memory.
DATABASE_URL=
# Auth0 (Doc 06). When AUTH0_DOMAIN + AUTH0_AUDIENCE are set, host endpoints require an Auth0 access
# token with a host:<session> or host:* permission. Required in production. The client ID is public.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
# Local-only fallback when Auth0 is not configured (ignored when it is; refused in production).
HOST_DEV_KEY=change-me
# Optional comma-separated allowlist for CORS in production
CORS_ORIGINS=
# Gemini API key (Google AI Studio). Omit to run with AI unavailable.
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash-lite)
GEMINI_MODEL=
# Song list: a JSON file of real songs (path from the repo root). Omit to use the built-in demo tracks.
# Format: apps/server/catalog.example.json (spotifyUri optional; share links accepted).
CATALOG_FILE=

# Spotify playback on the player page (needs Premium). Client ID only — the Client Secret is NOT used.
SPOTIFY_CLIENT_ID=

# Solana devnet boosts (optional). Public devnet address that receives boost payments — not a secret.
# Leave empty to disable boosts. Mainnet is refused.
BOOST_RECIPIENT=
SOLANA_CLUSTER=devnet
# Server-side RPC used to verify boosts (may include a provider API key — never sent to browsers)
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public RPC browsers use for wallet transactions (no keys)
SOLANA_PUBLIC_RPC_URL=https://api.devnet.solana.com
# 1,000,000 lamports = 0.001 devnet SOL
BOOST_LAMPORTS=1000000
