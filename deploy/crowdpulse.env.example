# /etc/crowdpulse/crowdpulse.env — production settings (chmod 600, owner crowdpulse).
# Never commit real values. Rotate anything that leaks.

# Public URL attendees open (cloud-init pre-fills this with <ip>.sslip.io). Locks allowed origins.
PUBLIC_URL=https://__DOMAIN__
# Extra allowed browser origins, comma-separated (usually empty).
CORS_ORIGINS=

# Auth0 (required in production). Add https://__DOMAIN__/auth/callback to Allowed Callback URLs,
# and https://__DOMAIN__ to Allowed Logout URLs + Allowed Web Origins.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=

# TigerData connection string (Console → service → Connect)
DATABASE_URL=

# Gemini (optional — AI shows "unavailable" without it)
GEMINI_API_KEY=
GEMINI_MODEL=

# Solana devnet boosts (optional; public devnet address, not a secret)
BOOST_RECIPIENT=
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
BOOST_LAMPORTS=1000000

# Per-IP abuse backstop per minute (a whole venue can share one IP)
RATE_LIMIT_IP_PER_MIN=6000
