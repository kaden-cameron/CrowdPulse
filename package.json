{
  "name": "crowdpulse",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@crowdpulse/web",
    "dev:server": "npm run dev --workspace=@crowdpulse/server",
    "build": "npm run build --workspace=@crowdpulse/shared && npm run build --workspace=@crowdpulse/web && npm run build --workspace=@crowdpulse/server",
    "start": "NODE_ENV=production npm start --workspace=@crowdpulse/server",
    "test": "npm test --workspace=@crowdpulse/server && npm test --workspace=@crowdpulse/web",
    "load-test": "npm run load-test --workspace=@crowdpulse/server",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "e2e:check": "node scripts/e2e-check.mjs",
    "demo:crowd": "node scripts/demo-crowd.mjs",
    "e2e:browser": "npm run e2e --workspace=@crowdpulse/web",
    "test:matrix": "node scripts/test-matrix.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
